# Copy these keys into Render (or Railway) → Environment.
# Do NOT commit real values. Generate JWT with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000

# Exact public URL of THIS service (no trailing path). Example:
CLIENT_URL=https://pixel-lift-api.onrender.com

# Firebase Admin (from service account JSON — use env vars on cloud; no JSON file)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste key as one line with \n for newlines (Render multiline also works)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

JWT_SECRET=minimum_32_character_random_string_here
JWT_REFRESH_SECRET=another_32_character_random_string_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional: real OTP email. If SMTP_USER empty, OTP only appears in server logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pixel Lift <your@gmail.com>

# Not used when ml-service is not deployed (mobile uses ML_CLOUD_ENABLED=false)
ML_SERVICE_URL=http://localhost:8000
